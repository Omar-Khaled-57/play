#!/usr/bin/env python3
"""hud - translucent HUD overlay. Backend for: play <game> hud.

Shows a small always-on-top overlay in the top-right corner with live system
stats. Left-drag to reposition, scroll wheel changes opacity, right-click
quits. Run standalone for general machine monitoring with: play hud
(or play --hud).

FPS comes from play's own Vulkan layer (see fpslayer/), which writes the
frame rate to PLAY_FPS_FILE (default /tmp/play/fps.txt) - no MangoHud.

Options (environment):
  HMNTR_METERS="cpu gpu ram fps"      subset to show (cpu includes temp)
  HMNTR_INTERVAL=1                         refresh seconds
  HMNTR_OPACITY=0.75                       initial overlay opacity
  PLAY_FPS_FILE=/tmp/play/fps.txt          FPS file written by the play layer
"""
import os
import sys
import time
import signal
import subprocess

PLAY_FPS_FILE = os.environ.get("PLAY_FPS_FILE", "/tmp/play/fps.txt")

C_NORM = "#eceff4"
C_DIM = "#9aa4bd"
C_WARN = "#f4d35e"
C_CRIT = "#ff5c5c"

FONT_FAMILY = "monospace"
FONT_SIZE = 13


class State:
    t = None
    i = None


def cpu_usage(st):
    try:
        with open("/proc/stat") as f:
            p = f.readline().split()
        t = sum(int(x) for x in p[1:])
        i = int(p[4])
        if st.t is None:
            st.t, st.i = t, i
            return 0
        db = (t - i) - (st.t - st.i)
        dt = t - st.t
        st.t, st.i = t, i
        return int(db * 100 / dt) if dt > 0 else 0
    except (OSError, ValueError, IndexError):
        return None


def ram():
    try:
        total = avail = 0
        with open("/proc/meminfo") as f:
            for line in f:
                k, v = line.split(":", 1)
                if k == "MemTotal":
                    total = int(v.split()[0])
                elif k == "MemAvailable":
                    avail = int(v.split()[0])
        if not total:
            return None, None
        return (total - avail) / 1024 / 1024, total / 1024 / 1024
    except (OSError, ValueError):
        return None, None


def cpu_temp():
    base = "/sys/class/thermal"
    try:
        zones = [z for z in sorted(os.listdir(base)) if z.startswith("thermal_zone")]
    except OSError:
        return None
    for z in zones:
        try:
            typ = open(os.path.join(base, z, "type")).read().strip()
        except OSError:
            continue
        if any(k in typ.lower() for k in ("x86_pkg", "acpitz", "cpu", "package")):
            try:
                t = int(open(os.path.join(base, z, "temp")).read().strip()) // 1000
            except (OSError, ValueError):
                continue
            if t > 0:
                return t
    for z in zones:
        try:
            t = int(open(os.path.join(base, z, "temp")).read().strip()) // 1000
        except (OSError, ValueError):
            continue
        if t > 0:
            return t
    return None


_GPU_TTL = 2.0
_gpu_cache = {"v": (None, None), "t": 0.0}


def gpu():
    now = time.time()
    if now - _gpu_cache["t"] < _GPU_TTL:
        return _gpu_cache["v"]
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=utilization.gpu,temperature.gpu",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=2)
        parts = [p.strip() for p in out.stdout.split(",")]
        _gpu_cache["v"] = (int(parts[0]), int(parts[1]))
    except Exception:
        _gpu_cache["v"] = (None, None)
    _gpu_cache["t"] = now
    return _gpu_cache["v"]


def fps():
    try:
        m = os.path.getmtime(PLAY_FPS_FILE)
    except OSError:
        return None
    if time.time() - m > 2.0:
        return None
    try:
        with open(PLAY_FPS_FILE) as f:
            return int(float(f.read().strip()))
    except (OSError, ValueError):
        return None


def overlay(Gtk, Gdk, GLib, meters, interval, opacity):
    state = State()
    margin = 12
    pad_x, pad_y = 14, 8
    op = {"v": max(0.35, min(1.0, opacity))}
    markup = [""]
    moved = {"v": False}

    win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
    win.set_app_paintable(True)
    win.set_decorated(False)
    win.set_skip_taskbar_hint(True)
    win.set_accept_focus(False)
    win.set_can_focus(False)
    win.set_focus_on_map(False)
    win.set_keep_above(True)
    rgba = win.get_screen().get_rgba_visual()
    if rgba:
        win.set_visual(rgba)

    provider = Gtk.CssProvider()
    Gtk.StyleContext.add_provider_for_screen(
        win.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def apply_css():
        provider.load_from_data(
            ("#hudbox { background-color: rgba(10, 10, 15, %g); "
             "border-radius: 12px; padding: %dpx %dpx; "
             "font-family: %s; font-size: %dpt; }")
            % (op["v"], pad_y, pad_x, FONT_FAMILY, FONT_SIZE))
    apply_css()

    box = Gtk.Box()
    box.set_name("hudbox")
    win.add(box)
    label = Gtk.Label()
    label.set_use_markup(True)
    label.set_single_line_mode(True)
    box.add(label)

    def dim(label):
        return '<span color="%s">%s</span>' % (C_DIM, label)

    def val(v, warn, crit):
        if v is None:
            return "n/a"
        if v >= crit:
            c = C_CRIT
        elif v >= warn:
            c = C_WARN
        else:
            c = C_NORM
        return '<span foreground="%s">%d</span>' % (c, v)

    def build_markup():
        cpu = cpu_usage(state) if "cpu" in meters else None
        temp = cpu_temp() if "cpu" in meters else None
        gu, gt = gpu() if "gpu" in meters else (None, None)
        ru, rt = ram() if "ram" in meters else (None, None)
        fpsv = fps() if "fps" in meters else None
        segs = []
        for m in meters:
            if m == "cpu" and cpu is not None:
                s = "%s %s%%" % (dim("CPU"), val(cpu, 70, 90))
                if temp is not None:
                    s += " %sC" % val(temp, 65, 80)
                segs.append(s)
            elif m == "gpu" and gu is not None:
                s = "%s %s%%" % (dim("GPU"), val(gu, 70, 90))
                if gt is not None:
                    s += " %sC" % val(gt, 65, 80)
                segs.append(s)
            elif m == "ram" and ru is not None and rt is not None:
                segs.append("%s %d/%dGB" % (dim("RAM"), ru, rt))
            elif m == "fps" and fpsv is not None:
                segs.append("%s %d" % (dim("FPS"), fpsv))
        return "  ".join(segs)

    def measure():
        layout = label.create_pango_layout("")
        layout.set_markup(markup[0])
        return layout.get_pixel_size()

    def place(tw, th):
        display = win.get_screen().get_display()
        gdk_win = win.get_window()
        mon = display.get_monitor_at_window(gdk_win) if gdk_win \
            else display.get_primary_monitor()
        sw = mon.get_geometry().width
        w = min(tw + 2 * pad_x, max(sw - 2 * margin, 1))
        h = th + 2 * pad_y
        win.resize(w, h)
        if not moved["v"]:
            win.move(sw - w - margin, margin)
    def set_override_redirect():
        try:
            import ctypes
            from gi.repository import GdkX11
        except (ImportError, ValueError):
            return
        gdk_win = win.get_window()
        if gdk_win is None:
            return
        xid = GdkX11.X11Window.get_xid(gdk_win)
        x11 = ctypes.CDLL("libX11.so.6")
        x11.XOpenDisplay.restype = ctypes.c_void_p
        x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
        x11.XChangeWindowAttributes.restype = None
        x11.XChangeWindowAttributes.argtypes = [ctypes.c_void_p,
                                                ctypes.c_ulong,
                                                ctypes.c_ulong,
                                                ctypes.c_void_p]
        x11.XFlush.restype = None
        x11.XFlush.argtypes = [ctypes.c_void_p]

        xdpy = x11.XOpenDisplay(os.environ.get("DISPLAY", ":0").encode())
        if not xdpy:
            return

        class XSetWindowAttributes(ctypes.Structure):
            _fields_ = [
                ("background_pixel", ctypes.c_ulong),
                ("background_pixmap", ctypes.c_ulong),
                ("border_pixel", ctypes.c_ulong),
                ("border_pixmap", ctypes.c_ulong),
                ("bit_gravity", ctypes.c_int),
                ("win_gravity", ctypes.c_int),
                ("backing_store", ctypes.c_int),
                ("backing_planes", ctypes.c_ulong),
                ("backing_pixel", ctypes.c_ulong),
                ("save_under", ctypes.c_int),
                ("event_mask", ctypes.c_long),
                ("do_not_propagate_mask", ctypes.c_long),
                ("override_redirect", ctypes.c_int),
                ("colormap", ctypes.c_ulong),
                ("cursor", ctypes.c_ulong),
            ]

        attrs = XSetWindowAttributes()
        attrs.override_redirect = 1
        CWOverrideRedirect = 1 << 9
        x11.XChangeWindowAttributes(xdpy, xid, CWOverrideRedirect,
                                    ctypes.byref(attrs))
        x11.XFlush(xdpy)

    win.realize()
    set_override_redirect()

    def tick():
        markup[0] = build_markup()
        label.set_markup(markup[0])
        try:
            tw, th = measure()
        except AttributeError:
            return True
        place(tw, th)
        return True

    drag = {"active": False, "dx": 0, "dy": 0}

    def on_press(w, ev):
        if ev.button == 3:
            Gtk.main_quit()
            return True
        if ev.button == 1:
            drag["active"] = True
            drag["dx"] = int(ev.x_root) - win.get_position()[0]
            drag["dy"] = int(ev.y_root) - win.get_position()[1]
            moved["v"] = True
            gdk_win = win.get_window()
            if gdk_win is not None:
                gdk_win.raise_()
                try:
                    Gdk.pointer_grab(gdk_win, True,
                                     Gdk.EventMask.BUTTON_RELEASE_MASK
                                     | Gdk.EventMask.POINTER_MOTION_MASK,
                                     None, None, 0)
                except Exception:
                    pass
            return True
        return False

    def on_release(w, ev):
        drag["active"] = False
        try:
            Gdk.pointer_ungrab(0)
        except Exception:
            pass
        return False

    def on_motion(w, ev):
        if drag["active"]:
            win.move(int(ev.x_root) - drag["dx"],
                     int(ev.y_root) - drag["dy"])
            return True
        return False

    def on_scroll(w, ev):
        if ev.direction == Gdk.ScrollDirection.UP:
            op["v"] = min(1.0, op["v"] + 0.05)
        elif ev.direction == Gdk.ScrollDirection.DOWN:
            op["v"] = max(0.35, op["v"] - 0.05)
        apply_css()
        return True

    win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                   | Gdk.EventMask.BUTTON_RELEASE_MASK
                   | Gdk.EventMask.POINTER_MOTION_MASK
                   | Gdk.EventMask.SCROLL_MASK)
    win.connect("button-press-event", on_press)
    win.connect("button-release-event", on_release)
    win.connect("motion-notify-event", on_motion)
    win.connect("scroll-event", on_scroll)

    def _quit(*_a):
        Gtk.main_quit()

    for s in (signal.SIGINT, signal.SIGTERM):
        signal.signal(s, _quit)

    win.show_all()

    def tick_once():
        tick()
        return False

    GLib.idle_add(tick_once)
    GLib.timeout_add(int(interval * 1000), tick)
    Gtk.main()


def _parse_float(s, default, lo, hi):
    try:
        v = float(s)
    except (TypeError, ValueError):
        v = default
    return max(lo, min(hi, v))


def gi_pkg_hint():
    """Print the right python3-gi / GTK3 install command for this distro
    (Ubuntu: apt, Fedora: dnf)."""
    pkg = "sudo apt install python3-gi gir1.2-gtk-3.0"
    try:
        with open("/etc/os-release") as f:
            data = f.read()
    except OSError:
        return pkg
    ident = ""
    for line in data.splitlines():
        if line.startswith("ID="):
            ident = line.split("=", 1)[1].strip().strip('"')
            break
    if ident in ("fedora", "rhel", "centos", "rocky", "alma"):
        return "sudo dnf install python3-gobject gtk3"
    if ident in ("arch", "manjaro", "endeavouros"):
        return "sudo pacman -S python3-gobject gtk3"
    if ident.startswith("opensuse"):
        return "sudo zypper install python3-gobject gtk3"
    return pkg


def main():
    meters = (os.environ.get("HMNTR_METERS") or "cpu gpu ram fps").split()
    unknown = [m for m in meters if m not in ("cpu", "gpu", "ram", "fps")]
    if unknown:
        print("hud: unknown meter(s): %s (known: cpu gpu ram fps)"
              % ", ".join(unknown), file=sys.stderr)
    interval = _parse_float(os.environ.get("HMNTR_INTERVAL", "1"), 1, 0.1, 3600)
    opacity = _parse_float(os.environ.get("HMNTR_OPACITY", "0.75"), 0.75, 0.35, 1.0)
    argv = sys.argv[1:]
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help"):
            print("hud: HUD overlay used by: play <game> hud")
            print("env:  HMNTR_METERS HMNTR_INTERVAL HMNTR_OPACITY PLAY_FPS_FILE")
            print("opts: -n/--interval SECS, --opacity 0.35-1.0")
            return 0
        elif a in ("-n", "--interval") and i + 1 < len(argv):
            interval = _parse_float(argv[i + 1], interval, 0.1, 3600)
            i += 1
        elif a == "--opacity" and i + 1 < len(argv):
            opacity = _parse_float(argv[i + 1], opacity, 0.35, 1.0)
            i += 1
        else:
            print("hud: unknown option: %s" % a, file=sys.stderr)
            return 2
        i += 1

    if "DISPLAY" in os.environ and os.environ.get("GDK_BACKEND") is None:
        os.environ["GDK_BACKEND"] = "x11"

    try:
        import gi
        gi.require_version("Gtk", "3.0")
        from gi.repository import Gtk, Gdk, GLib
    except (ImportError, ValueError) as e:
        print("hud: python3-gi (GTK3) required for the HUD: %s" % e, file=sys.stderr)
        print("hud: install it with: %s" % gi_pkg_hint(), file=sys.stderr)
        return 1

    try:
        overlay(Gtk, Gdk, GLib, meters, interval, opacity)
        return 0
    except Exception as e:
        print("hud: %s" % e, file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
