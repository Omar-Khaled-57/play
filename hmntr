#!/bin/bash
# hmntr — minimal one-line health bar: CPU, GPU, RAM, temp, FPS.
#
# Usage:
#   hmntr                       show all meters
#   hmntr --cpu --gpu           show only CPU and GPU
#   hmntr --exclude-fps         all meters except FPS
#   hmntr -n 2                  refresh every 2 seconds
#
# FPS meter reads MangoHud's log (set by: play game.exe Hud), else shows n/a.
set -u

ARGS=("$@")

C_RESET="$(tput sgr0 2>/dev/null)"
C_DIM="$(tput dim 2>/dev/null)"
C_RED="$(tput setaf 1 2>/dev/null)"
C_YELLOW="$(tput setaf 3 2>/dev/null)"

MANGOHUD_LOG="${MANGOHUD_LOG_FILE:-/tmp/play/mangohud.log}"
INTERVAL=1

usage() {
  echo "usage: hmntr [--<meter>...] [--exclude-<meter>...] [-n seconds]"
  echo "meters: cpu gpu ram fps cputemp"
  echo "  --cpu --gpu --ram --fps --cputemp   show only these meters"
  echo "  --exclude-<meter>                    hide that meter"
  echo "  -n <sec>                             refresh interval (default 1)"
  exit 0
}

ALL=(cpu gpu ram fps cputemp)
SINGLE=0
EXCLUDE=()
i=0
while [ $i -lt ${#ARGS[@]} ]; do
  a="${ARGS[$i]}"
  case "$a" in
    --help|-h) usage ;;
    -n|--interval) i=$((i + 1)); INTERVAL="${ARGS[$i]:-1}" ;;
    --cpu|--gpu|--ram|--fps|--cputemp) SINGLE=1 ;;
    --exclude-*) EXCLUDE+=("${a#--exclude-}") ;;
    *) echo "unknown option: $a"; usage ;;
  esac
  i=$((i + 1))
done

ENABLED=()
if [ "$SINGLE" -eq 1 ]; then
  for a in "${ARGS[@]}"; do
    case "$a" in
      --cpu|--gpu|--ram|--fps|--cputemp)
        m="${a#--}"
        case " ${ENABLED[*]} " in
          *" $m "*) ;;
          *) ENABLED+=("$m") ;;
        esac
        ;;
    esac
  done
else
  ENABLED=("${ALL[@]}")
fi

FILTERED=()
for e in "${ENABLED[@]}"; do
  skip=0
  for x in "${EXCLUDE[@]}"; do
    [ "$e" = "$x" ] && skip=1
  done
  [ "$skip" -eq 0 ] && FILTERED+=("$e")
done
ENABLED=("${FILTERED[@]}")

if [ ${#ENABLED[@]} -eq 0 ]; then
  echo "no meters selected"
  exit 1
fi

cpu_tot() { awk '/^cpu /{s=0; for(i=2;i<=NF;i++) s+=$i} END{print s}' /proc/stat; }
cpu_idl() { awk '/^cpu /{print $5}' /proc/stat; }

cpu_usage() {
  local t1 i1 t2 i2
  t1="$(cpu_tot)"; i1="$(cpu_idl)"
  sleep 0.3
  t2="$(cpu_tot)"; i2="$(cpu_idl)"
  awk -v t1="$t1" -v i1="$i1" -v t2="$t2" -v i2="$i2" \
    'BEGIN{ d=t2-t1; b=(t2-i2)-(t1-i1); if(d>0) printf "%d", b*100/d; else print 0 }'
}

ram_pct() {
  awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{ if(t>0) printf "%d", (t-a)*100/t; else print 0 }' /proc/meminfo
}

ram_used() {
  awk '/^MemTotal:/{t=$2} /^MemAvailable:/{a=$2} END{ if(t>0) printf "%d", (t-a)/1024/1024; else print 0 }' /proc/meminfo
}

ram_total() {
  awk '/^MemTotal:/{t=$2} END{ if(t>0) printf "%d", t/1024/1024; else print 0 }' /proc/meminfo
}

cpu_temp() {
  local z t
  for z in /sys/class/thermal/thermal_zone*; do
    [ -f "$z/temp" ] || continue
    t="$(cat "$z/temp" 2>/dev/null)"
    case "$(cat "$z/type" 2>/dev/null)" in
      x86_pkg_temp|acpitz|*cpu*|*CPU*|*package*)
        [ -n "$t" ] && [ "$t" -gt 0 ] 2>/dev/null && { echo "$((t / 1000))"; return; } ;;
    esac
  done
  for z in /sys/class/thermal/thermal_zone*; do
    [ -f "$z/temp" ] || continue
    t="$(cat "$z/temp" 2>/dev/null)"
    [ -n "$t" ] && [ "$t" -gt 0 ] 2>/dev/null && { echo "$((t / 1000))"; return; }
  done
  echo "n/a"
}

gpu_usage() {
  if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits 2>/dev/null | head -1
    return
  fi
  for d in /sys/class/drm/card*/device/gpu_busy_percent; do
    [ -f "$d" ] && cat "$d" && return
  done
  echo "n/a"
}

gpu_temp() {
  command -v nvidia-smi >/dev/null 2>&1 || { echo "n/a"; return; }
  local t
  t="$(nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits 2>/dev/null | head -1)"
  [ -n "$t" ] && echo "$t" || echo "n/a"
}

fps_value() {
  [ -s "$MANGOHUD_LOG" ] || { echo "n/a"; return; }
  local header line
  header="$(head -1 "$MANGOHUD_LOG")"
  line="$(tail -1 "$MANGOHUD_LOG")"
  if [[ "$header" =~ [a-zA-Z] ]]; then
    local -a cols; IFS=',' read -ra cols <<< "$header"
    local i col=1
    for i in "${!cols[@]}"; do
      case "${cols[$i]//\"/}" in fps) col=$((i + 1)) ;; esac
    done
    echo "$line" | cut -d, -f"$col"
  else
    echo "$line" | awk -F, '{print $NF}'
  fi
}

colorize() {
  local v="$1" warn="$2" crit="$3"
  [ "$v" = "n/a" ] && { echo "n/a"; return; }
  if   [ "$v" -ge "$crit" ]; then echo "${C_RED}$v${C_RESET}"
  elif [ "$v" -ge "$warn" ]; then echo "${C_YELLOW}$v${C_RESET}"
  else echo "$v"; fi
}

build_line() {
  local line="" m
  for m in "${ENABLED[@]}"; do
    case "$m" in
      cpu)
        line+="${line:+  }${C_DIM}CPU${C_RESET} $(colorize "$CPU" 70 90)%" ;;
      gpu)
        line+="${line:+  }${C_DIM}GPU${C_RESET} $(colorize "$GPU" 70 90)%"
        [ "$GTEMP" != "n/a" ] && line+=" $(colorize "$GTEMP" 65 80)C" ;;
      ram)
        line+="${line:+  }${C_DIM}RAM${C_RESET} ${RAM_U}G/${RAM_T}G" ;;
      cputemp)
        line+="${line:+  }${C_DIM}TMP${C_RESET} $(colorize "$TEMP" 65 80)C" ;;
      fps)
        line+="${line:+  }${C_DIM}FPS${C_RESET} $FPS" ;;
    esac
  done
  printf '%s' "$line"
}

cleanup() {
  printf "\r\033[K"
  tput cnorm 2>/dev/null
  exit 0
}
trap cleanup INT TERM

tput civis 2>/dev/null
while true; do
  CPU="$(cpu_usage)"; GPU="$(gpu_usage)"; GTEMP="$(gpu_temp)"
  RAM_U="$(ram_used)"; RAM_T="$(ram_total)"; TEMP="$(cpu_temp)"; FPS="$(fps_value)"
  GPU="${GPU:-n/a}"; GTEMP="${GTEMP:-n/a}"; FPS="${FPS:-n/a}"
  LINE="$(build_line)"
  printf "\r\033[K%s\033[1A\n" "$LINE"
  sleep "$INTERVAL"
done
